{
  "name": "atlas-launch-film",
  "version": "1.0.0",
  "private": true,
  "description": "Atlas Research \u2014 60-second cinematic brand launch film (Remotion)",
  "type": "module",
  "scripts": {
    "dev": "remotion studio",
    "typecheck": "tsc --noEmit",
    "audio": "node scripts/generate-score.mjs",
    "render:16x9": "remotion render AtlasLaunch output/atlas-launch-16x9.mp4 --codec=h264 --crf=16",
    "render:9x16": "remotion render AtlasLaunchVertical output/atlas-launch-9x16.mp4 --codec=h264 --crf=16",
    "render:poster": "remotion still AtlasPoster output/atlas-launch-poster.png",
    "render:all": "npm run render:16x9 && npm run render:9x16 && npm run render:poster",
    "audio:v2": "node scripts/generate-score-v2.mjs",
    "render:v2:16x9": "remotion render AtlasLaunchV2 output/atlas-launch-v2-16x9.mp4 --codec=h264 --crf=16",
    "render:v2:9x16": "remotion render AtlasLaunchV2Vertical output/atlas-launch-v2-9x16.mp4 --codec=h264 --crf=17",
    "render:v2:teaser": "remotion render AtlasTeaserV2 output/atlas-teaser-v2-9x16.mp4 --codec=h264 --crf=17",
    "render:v2:silent": "remotion render AtlasLaunchV2 output/atlas-launch-v2-16x9-silent.mp4 --codec=h264 --crf=16 --props={\"withAudio\":false,\"musicVolume\":0}",
    "render:v2": "npm run render:v2:16x9 && npm run render:v2:9x16 && npm run render:v2:teaser",
    "qa:v2": "node scripts/stills.mjs AtlasLaunchV2 && node scripts/stills.mjs AtlasLaunchV2Vertical"
  },
  "dependencies": {
    "@fontsource/geist-sans": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/lora": "5.3.0",
    "@remotion/cli": "4.0.539",
    "@remotion/fonts": "4.0.539",
    "@remotion/media": "4.0.539",
    "lucide-react": "1.68.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.539"
  },
  "devDependencies": {
    "@remotion/bundler": "4.0.539",
    "@remotion/renderer": "4.0.539",
    "@types/react": "19.2.2",
    "typescript": "5.9.3"
  }
}
