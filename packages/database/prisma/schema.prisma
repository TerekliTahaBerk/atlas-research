generator client {
 provider = "prisma-client"
 output = "../src/generated/client"
}
datasource db {
 provider = "postgresql"
}
enum OrganizationRole {
 OWNER
 ADMIN
 MEMBER
}
enum WorkspaceRole {
 ADMIN
 MEMBER
 VIEWER
}
enum ProjectRole {
 OWNER
 EDITOR
 VIEWER
}
enum ProjectVisibility {
 PRIVATE
 WORKSPACE
}
model Profile {
 id String @id @db.Uuid
 displayName String @map("display_name") @db.VarChar(120)
 createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
 updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
 deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
 researchRole String? @map("research_role") @db.VarChar(120)
 researchInterests String[] @default([]) @map("research_interests")
 avatarReference String? @map("avatar_reference") @db.VarChar(500)
 onboardingDraft Json @default("{}") @map("onboarding_draft")
 onboardingCompletedAt DateTime? @map("onboarding_completed_at") @db.Timestamptz(3)
 organizationMemberships OrganizationMembership[]
 @@map("profiles")
}
model Organization {
 id String @id @default(uuid()) @db.Uuid
 name String @db.VarChar(120)
 personal Boolean @default(false)
 personalOwnerId String? @unique @map("personal_owner_id") @db.Uuid
 createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
 updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
 deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
 version Int @default(1)
 memberships OrganizationMembership[]
 workspaces Workspace[]
 @@map("organizations")
}
model OrganizationMembership {
 organizationId String @map("organization_id") @db.Uuid
 profileId String @map("profile_id") @db.Uuid
 role OrganizationRole @default(MEMBER)
 createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
 updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
 organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
 profile Profile @relation(fields: [profileId], references: [id], onDelete: Restrict)
 workspaceMemberships WorkspaceMembership[]
 @@id([organizationId, profileId])
 @@index([profileId, organizationId])
 @@map("organization_memberships")
 version Int @default(1)
}
model Workspace {
 id String @id @default(uuid()) @db.Uuid
 organizationId String @map("organization_id") @db.Uuid
 name String @db.VarChar(120)
 createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
 updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
 deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
 organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
 personalOwnerId String? @unique @map("personal_owner_id") @db.Uuid
 version Int @default(1)
 memberships WorkspaceMembership[]
 projects Project[]
 @@unique([organizationId, id])
 @@index([organizationId, deletedAt])
 @@map("workspaces")
}
model WorkspaceMembership {
 organizationId String @map("organization_id") @db.Uuid
 workspaceId String @map("workspace_id") @db.Uuid
 profileId String @map("profile_id") @db.Uuid
 role WorkspaceRole @default(MEMBER)
 createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
 updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
 workspace Workspace @relation(fields: [organizationId, workspaceId], references: [organizationId, id], onDelete: Restrict)
 organizationMembership OrganizationMembership @relation(fields: [organizationId, profileId], references: [organizationId, profileId], onDelete: Restrict)
 projectMemberships ProjectMembership[]
 @@id([workspaceId, profileId])
 @@unique([organizationId, workspaceId, profileId])
 @@index([profileId, organizationId])
 @@map("workspace_memberships")
 version Int @default(1)
}
model Project {
 id String @id @default(uuid()) @db.Uuid
 organizationId String @map("organization_id") @db.Uuid
 workspaceId String @map("workspace_id") @db.Uuid
 name String @db.VarChar(120)
 visibility ProjectVisibility @default(PRIVATE)
 createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
 updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
 deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
 workspace Workspace @relation(fields: [organizationId, workspaceId], references: [organizationId, id], onDelete: Restrict)
 createdById String? @map("created_by_id") @db.Uuid
 creationKey String? @map("creation_key") @db.Uuid
 version Int @default(1)
 @@unique([createdById, creationKey])
 memberships ProjectMembership[]
 @@unique([organizationId, workspaceId, id])
 @@index([workspaceId, deletedAt, createdAt, id])
 @@map("projects")
}
model ProjectMembership {
 organizationId String @map("organization_id") @db.Uuid
 workspaceId String @map("workspace_id") @db.Uuid
 projectId String @map("project_id") @db.Uuid
 profileId String @map("profile_id") @db.Uuid
 role ProjectRole @default(VIEWER)
 createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
 updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
 project Project @relation(fields: [organizationId, workspaceId, projectId], references: [organizationId, workspaceId, id], onDelete: Restrict)
 workspaceMembership WorkspaceMembership @relation(fields: [organizationId, workspaceId, profileId], references: [organizationId, workspaceId, profileId], onDelete: Restrict)
 @@id([projectId, profileId])
 @@index([workspaceId, profileId])
 @@map("project_memberships")
 version Int @default(1)
}

model Invitation {
 id String @id @default(uuid()) @db.Uuid
 organizationId String @map("organization_id") @db.Uuid
 workspaceId String? @map("workspace_id") @db.Uuid
 projectId String? @map("project_id") @db.Uuid
 scope String @db.VarChar(20)
 role String @db.VarChar(10)
 email String @db.VarChar(254)
 inviterId String @map("inviter_id") @db.Uuid
 tokenHash String @unique @map("token_hash") @db.VarChar(64)
 expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
 createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
 acceptedAt DateTime? @map("accepted_at") @db.Timestamptz(3)
 revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
 @@index([organizationId, createdAt, id])
 @@map("invitations")
}
model AuditEvent {
 id String @id @default(uuid()) @db.Uuid
 organizationId String? @map("organization_id") @db.Uuid
 actorId String @map("actor_id") @db.Uuid
 action String @db.VarChar(80)
 resourceId String? @map("resource_id") @db.Uuid
 requestId String @map("request_id") @db.Uuid
 createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
 @@index([organizationId, createdAt, id])
 @@map("audit_events")
}
model RateBucket {
 key String @id @db.VarChar(128)
 hits Int @default(1)
 expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
 @@index([expiresAt])
 @@map("rate_buckets")
}

// Phase 02 research library. Composite tenant FKs, checks, RLS, triggers and
// the fixed command boundary are hand-written in the reviewed migration SQL.
enum ReadingStatus {
 TO_READ
 READING
 READ
 ARCHIVED
}
enum SourceState {
 PENDING_UPLOAD
 QUARANTINED
 SCANNING
 PROCESSING
 READY
 FAILED
 REJECTED
}
enum AnnotationKind {
 HIGHLIGHT
 NOTE
 PAGE_NOTE
}
enum AnnotationVisibility {
 PROJECT
 PRIVATE
}
enum JobState {
 QUEUED
 RUNNING
 SUCCEEDED
 RETRYABLE
 FAILED
}
model ResearchPaper {
 id String @id @db.Uuid
 normalizedDoi String? @unique @map("normalized_doi") @db.VarChar(300)
 title String @db.VarChar(1000)
 metadata Json
 createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
 updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
 @@map("research_papers")
}
model PaperExternalIdentifier {
 provider String @db.VarChar(30)
 externalId String @map("external_id") @db.VarChar(200)
 paperId String @map("paper_id") @db.Uuid
 createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
 @@id([provider, externalId])
 @@index([paperId])
 @@map("paper_external_identifiers")
}
model Artifact {
 id String @id @db.Uuid
 organizationId String @map("organization_id") @db.Uuid
 workspaceId String @map("workspace_id") @db.Uuid
 projectId String @map("project_id") @db.Uuid
 kind String @db.VarChar(30)
 createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
 deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
 @@unique([projectId, id])
 @@map("artifacts")
}
model ProjectPaper {
 id String @id @db.Uuid
 organizationId String @map("organization_id") @db.Uuid
 workspaceId String @map("workspace_id") @db.Uuid
 projectId String @map("project_id") @db.Uuid
 artifactId String @unique @map("artifact_id") @db.Uuid
 paperId String? @map("paper_id") @db.Uuid
 privateTitle String? @map("private_title") @db.VarChar(1000)
 metadata Json?
 readingStatus ReadingStatus @default(TO_READ) @map("reading_status")
 archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)
 addedById String @map("added_by_id") @db.Uuid
 version Int @default(1)
 createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
 updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
 @@unique([projectId, id])
 @@unique([projectId, paperId])
 @@index([projectId, createdAt, id])
 @@map("project_papers")
}
model PaperCollection {
 id String @id @db.Uuid
 organizationId String @map("organization_id") @db.Uuid
 workspaceId String @map("workspace_id") @db.Uuid
 projectId String @map("project_id") @db.Uuid
 name String @db.VarChar(120)
 description String? @db.VarChar(500)
 archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)
 createdById String @map("created_by_id") @db.Uuid
 version Int @default(1)
 createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
 updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
 @@unique([projectId, id])
 @@index([projectId, name, id])
 @@map("paper_collections")
}
model CollectionMembership {
 organizationId String @map("organization_id") @db.Uuid
 workspaceId String @map("workspace_id") @db.Uuid
 projectId String @map("project_id") @db.Uuid
 collectionId String @map("collection_id") @db.Uuid
 projectPaperId String @map("project_paper_id") @db.Uuid
 addedById String @map("added_by_id") @db.Uuid
 createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
 @@id([collectionId, projectPaperId])
 @@index([projectPaperId])
 @@map("collection_memberships")
}
model PaperTag {
 id String @id @db.Uuid
 organizationId String @map("organization_id") @db.Uuid
 workspaceId String @map("workspace_id") @db.Uuid
 projectId String @map("project_id") @db.Uuid
 name String @db.VarChar(40)
 normalizedName String @map("normalized_name") @db.VarChar(40)
 createdById String @map("created_by_id") @db.Uuid
 version Int @default(1)
 createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
 @@unique([projectId, id])
 @@unique([projectId, normalizedName])
 @@map("paper_tags")
}
model ProjectPaperTag {
 organizationId String @map("organization_id") @db.Uuid
 workspaceId String @map("workspace_id") @db.Uuid
 projectId String @map("project_id") @db.Uuid
 projectPaperId String @map("project_paper_id") @db.Uuid
 tagId String @map("tag_id") @db.Uuid
 createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
 @@id([projectPaperId, tagId])
 @@index([tagId])
 @@map("project_paper_tags")
}
model SourceVersion {
 id String @id @db.Uuid
 organizationId String @map("organization_id") @db.Uuid
 workspaceId String @map("workspace_id") @db.Uuid
 projectId String @map("project_id") @db.Uuid
 projectPaperId String @map("project_paper_id") @db.Uuid
 ordinal Int
 sourceType String @map("source_type") @db.VarChar(20)
 rightsBasis String @map("rights_basis") @db.VarChar(30)
 state SourceState @default(PENDING_UPLOAD)
 fileName String @map("file_name") @db.VarChar(200)
 mediaType String @map("media_type") @db.VarChar(100)
 declaredSize BigInt @map("declared_size")
 declaredSha256 String @map("declared_sha256") @db.Char(64)
 byteSize BigInt? @map("byte_size")
 sha256 String? @db.Char(64)
 quarantineKey String @unique @map("quarantine_key") @db.VarChar(500)
 objectKey String? @unique @map("object_key") @db.VarChar(500)
 failure String? @db.VarChar(200)
 scannedBy String? @map("scanned_by") @db.VarChar(120)
 scanCompletedAt DateTime? @map("scan_completed_at") @db.Timestamptz(3)
 readyAt DateTime? @map("ready_at") @db.Timestamptz(3)
 createdById String @map("created_by_id") @db.Uuid
 createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
 updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
 @@unique([projectId, id])
 @@unique([projectPaperId, id])
 @@unique([projectPaperId, ordinal])
 @@map("source_versions")
}
model UploadIntent {
 id String @id @db.Uuid
 organizationId String @map("organization_id") @db.Uuid
 workspaceId String @map("workspace_id") @db.Uuid
 projectId String @map("project_id") @db.Uuid
 sourceVersionId String @unique @map("source_version_id") @db.Uuid
 actorId String @map("actor_id") @db.Uuid
 expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
 finalizedAt DateTime? @map("finalized_at") @db.Timestamptz(3)
 createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
 @@map("upload_intents")
}
model IngestionJob {
 id String @id @db.Uuid
 organizationId String @map("organization_id") @db.Uuid
 workspaceId String @map("workspace_id") @db.Uuid
 projectId String @map("project_id") @db.Uuid
 sourceVersionId String @map("source_version_id") @db.Uuid
 kind String @db.VarChar(30)
 state JobState @default(QUEUED)
 attempts Int @default(0)
 availableAt DateTime @default(now()) @map("available_at") @db.Timestamptz(3)
 lockedUntil DateTime? @map("locked_until") @db.Timestamptz(3)
 lastError String? @map("last_error") @db.VarChar(200)
 createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
 updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
 @@unique([sourceVersionId, kind])
 @@index([kind, state, availableAt])
 @@map("ingestion_jobs")
}
model PaperAnnotation {
 id String @id @db.Uuid
 organizationId String @map("organization_id") @db.Uuid
 workspaceId String @map("workspace_id") @db.Uuid
 projectId String @map("project_id") @db.Uuid
 projectPaperId String @map("project_paper_id") @db.Uuid
 sourceVersionId String @map("source_version_id") @db.Uuid
 authorId String @map("author_id") @db.Uuid
 kind AnnotationKind
 visibility AnnotationVisibility @default(PROJECT)
 body String?
 anchor Json
 anchorStatus String @default("PRECISE") @map("anchor_status") @db.VarChar(20)
 version Int @default(1)
 createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
 updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
 deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
 @@index([sourceVersionId, createdAt, id])
 @@map("paper_annotations")
}
model ResearchCommandKey {
 actorId String @map("actor_id") @db.Uuid
 idempotencyKey String @map("idempotency_key") @db.Uuid
 command String @db.VarChar(60)
 requestHash String @map("request_hash") @db.Char(64)
 result Json
 createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
 @@id([actorId, idempotencyKey])
 @@map("research_command_keys")
}

// Internal durable cleanup reservations; no runtime table access.
model ScanObjectCleanup {
 attempt Int
 objectKey String @id @map("object_key")
 jobId String @map("job_id") @db.Uuid
 createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
 @@map("scan_object_cleanup")
}
