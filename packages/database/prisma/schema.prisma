generator client {
 provider = "prisma-client"
 output = "../src/generated/client"
}
datasource db {
 provider = "postgresql"
}
enum OrganizationRole {
 OWNER
 ADMIN
 MEMBER
}
enum WorkspaceRole {
 ADMIN
 MEMBER
 VIEWER
}
enum ProjectRole {
 OWNER
 EDITOR
 VIEWER
}
enum ProjectVisibility {
 PRIVATE
 WORKSPACE
}
model Profile {
 id String @id @db.Uuid
 displayName String @map("display_name") @db.VarChar(120)
 createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
 updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
 deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
 researchRole String? @map("research_role") @db.VarChar(120)
 researchInterests String[] @default([]) @map("research_interests")
 avatarReference String? @map("avatar_reference") @db.VarChar(500)
 onboardingDraft Json @default("{}") @map("onboarding_draft")
 onboardingCompletedAt DateTime? @map("onboarding_completed_at") @db.Timestamptz(3)
 organizationMemberships OrganizationMembership[]
 @@map("profiles")
}
model Organization {
 id String @id @default(uuid()) @db.Uuid
 name String @db.VarChar(120)
 personal Boolean @default(false)
 personalOwnerId String? @unique @map("personal_owner_id") @db.Uuid
 createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
 updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
 deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
 version Int @default(1)
 memberships OrganizationMembership[]
 workspaces Workspace[]
 @@map("organizations")
}
model OrganizationMembership {
 organizationId String @map("organization_id") @db.Uuid
 profileId String @map("profile_id") @db.Uuid
 role OrganizationRole @default(MEMBER)
 createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
 updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
 organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
 profile Profile @relation(fields: [profileId], references: [id], onDelete: Restrict)
 workspaceMemberships WorkspaceMembership[]
 @@id([organizationId, profileId])
 @@index([profileId, organizationId])
 @@map("organization_memberships")
 version Int @default(1)
}
model Workspace {
 id String @id @default(uuid()) @db.Uuid
 organizationId String @map("organization_id") @db.Uuid
 name String @db.VarChar(120)
 createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
 updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
 deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
 organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
 personalOwnerId String? @unique @map("personal_owner_id") @db.Uuid
 version Int @default(1)
 memberships WorkspaceMembership[]
 projects Project[]
 @@unique([organizationId, id])
 @@index([organizationId, deletedAt])
 @@map("workspaces")
}
model WorkspaceMembership {
 organizationId String @map("organization_id") @db.Uuid
 workspaceId String @map("workspace_id") @db.Uuid
 profileId String @map("profile_id") @db.Uuid
 role WorkspaceRole @default(MEMBER)
 createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
 updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
 workspace Workspace @relation(fields: [organizationId, workspaceId], references: [organizationId, id], onDelete: Restrict)
 organizationMembership OrganizationMembership @relation(fields: [organizationId, profileId], references: [organizationId, profileId], onDelete: Restrict)
 projectMemberships ProjectMembership[]
 @@id([workspaceId, profileId])
 @@unique([organizationId, workspaceId, profileId])
 @@index([profileId, organizationId])
 @@map("workspace_memberships")
 version Int @default(1)
}
model Project {
 id String @id @default(uuid()) @db.Uuid
 organizationId String @map("organization_id") @db.Uuid
 workspaceId String @map("workspace_id") @db.Uuid
 name String @db.VarChar(120)
 visibility ProjectVisibility @default(PRIVATE)
 createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
 updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
 deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
 workspace Workspace @relation(fields: [organizationId, workspaceId], references: [organizationId, id], onDelete: Restrict)
 createdById String? @map("created_by_id") @db.Uuid
 creationKey String? @map("creation_key") @db.Uuid
 version Int @default(1)
 @@unique([createdById, creationKey])
 memberships ProjectMembership[]
 @@unique([organizationId, workspaceId, id])
 @@index([workspaceId, deletedAt, createdAt, id])
 @@map("projects")
}
model ProjectMembership {
 organizationId String @map("organization_id") @db.Uuid
 workspaceId String @map("workspace_id") @db.Uuid
 projectId String @map("project_id") @db.Uuid
 profileId String @map("profile_id") @db.Uuid
 role ProjectRole @default(VIEWER)
 createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
 updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
 project Project @relation(fields: [organizationId, workspaceId, projectId], references: [organizationId, workspaceId, id], onDelete: Restrict)
 workspaceMembership WorkspaceMembership @relation(fields: [organizationId, workspaceId, profileId], references: [organizationId, workspaceId, profileId], onDelete: Restrict)
 @@id([projectId, profileId])
 @@index([workspaceId, profileId])
 @@map("project_memberships")
 version Int @default(1)
}

model Invitation {
 id String @id @default(uuid()) @db.Uuid
 organizationId String @map("organization_id") @db.Uuid
 workspaceId String? @map("workspace_id") @db.Uuid
 projectId String? @map("project_id") @db.Uuid
 scope String @db.VarChar(20)
 role String @db.VarChar(10)
 email String @db.VarChar(254)
 inviterId String @map("inviter_id") @db.Uuid
 tokenHash String @unique @map("token_hash") @db.VarChar(64)
 expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
 createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
 acceptedAt DateTime? @map("accepted_at") @db.Timestamptz(3)
 revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
 @@index([organizationId, createdAt, id])
 @@map("invitations")
}
model AuditEvent {
 id String @id @default(uuid()) @db.Uuid
 organizationId String? @map("organization_id") @db.Uuid
 actorId String @map("actor_id") @db.Uuid
 action String @db.VarChar(80)
 resourceId String? @map("resource_id") @db.Uuid
 requestId String @map("request_id") @db.Uuid
 createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
 @@index([organizationId, createdAt, id])
 @@map("audit_events")
}
model RateBucket {
 key String @id @db.VarChar(128)
 hits Int @default(1)
 expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
 @@index([expiresAt])
 @@map("rate_buckets")
}
