generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["identity", "app", "ops"]
}

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  ownedPersonal Workspace? @relation("PersonalOwner")
  createdSpaces Workspace[] @relation("WorkspaceCreator")
  memberships WorkspaceMember[]
  projectsCreated Project[]
  invitationsCreated Invitation[] @relation("InvitationCreator")
  invitationsAccepted Invitation[] @relation("InvitationAcceptor")
  @@map("users")
  @@schema("identity")
}

model MailOutbox {
  id String @id @db.Uuid
  payload String?
  state String @default("pending")
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now())
  leaseUntil DateTime?
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([state, nextAttemptAt])
  @@map("mail_outbox")
  @@schema("ops")
}

model Workspace {
  id String @id @db.Uuid
  kind String
  name String
  personalOwnerId String? @unique
  personalOwner User? @relation("PersonalOwner", fields: [personalOwnerId], references: [id], onDelete: Restrict)
  createdBy String
  creator User @relation("WorkspaceCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  archivedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  members WorkspaceMember[]
  projects Project[]
  @@map("workspaces")
  @@schema("app")
}

model SchemaRevision {
  id Int @id
  revision String
  @@map("schema_revision")
  @@schema("ops")
}
model ServiceHeartbeat {
  service String @id
  revision String
  checkedAt DateTime @db.Timestamptz
  @@map("service_heartbeat")
  @@schema("ops")
}

model WorkspaceMember {
  workspaceId String @db.Uuid
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  role String
  active Boolean @default(true)
  createdAt DateTime @default(now())
  projectMemberships ProjectMember[]
  @@id([workspaceId, userId])
  @@map("workspace_members")
  @@schema("app")
}

model Project {
  id String @id @db.Uuid
  workspaceId String @db.Uuid
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  name String
  description String @default("")
  createdBy String
  creator User @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  archivedAt DateTime?
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  members ProjectMember[]
  invitations Invitation[]
  @@unique([workspaceId, id])
  @@map("projects")
  @@schema("app")
}

model ProjectMember {
  workspaceId String @db.Uuid
  projectId String @db.Uuid
  userId String
  project Project @relation(fields: [workspaceId, projectId], references: [workspaceId, id], onDelete: Restrict)
  workspaceMember WorkspaceMember @relation(fields: [workspaceId, userId], references: [workspaceId, userId], onDelete: Restrict)
  role String
  active Boolean @default(true)
  createdAt DateTime @default(now())
  @@id([workspaceId, projectId, userId])
  @@map("project_members")
  @@schema("app")
}

model Invitation {
  id String @id @db.Uuid
  workspaceId String @db.Uuid
  projectId String @db.Uuid
  project Project @relation(fields: [workspaceId, projectId], references: [workspaceId, id], onDelete: Restrict)
  email String
  role String
  tokenHash String @unique
  createdBy String
  creator User @relation("InvitationCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  originSessionId String
  expiresAt DateTime
  acceptedAt DateTime?
  acceptedBy String?
  acceptor User? @relation("InvitationAcceptor", fields: [acceptedBy], references: [id], onDelete: Restrict)
  revokedAt DateTime?
  createdAt DateTime @default(now())
  @@index([workspaceId, projectId, email])
  @@map("invitations")
  @@schema("app")
}

model AuditEvent {
  id String @id @db.Uuid
  workspaceId String @db.Uuid
  projectId String? @db.Uuid
  actorId String
  event String
  targetId String?
  createdAt DateTime @default(now())
  @@index([workspaceId, projectId, createdAt])
  @@map("audit_events")
  @@schema("app")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@map("sessions")
  @@schema("identity")
}

model Account {
  id                     String    @id
  accountId              String
  providerId             String
  userId                 String
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken            String?
  refreshToken           String?
  idToken                String?
  accessTokenExpiresAt   DateTime?
  refreshTokenExpiresAt  DateTime?
  scope                  String?
  password               String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  @@index([userId])
  @@unique([providerId, accountId])
  @@map("accounts")
  @@schema("identity")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@index([identifier])
  @@map("verifications")
  @@schema("identity")
}

model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt
  @@map("rate_limits")
  @@schema("identity")
}
