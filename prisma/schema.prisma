generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["identity", "app", "ops"]
}

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  ownedPersonal Workspace? @relation("PersonalOwner")
  createdSpaces Workspace[] @relation("WorkspaceCreator")
  memberships WorkspaceMember[]
  projectsCreated Project[]
  invitationsCreated Invitation[] @relation("InvitationCreator")
  invitationsAccepted Invitation[] @relation("InvitationAcceptor")
  @@map("users")
  @@schema("identity")
}

model MailOutbox {
  id String @id @db.Uuid
  payload String?
  state String @default("pending")
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now())
  leaseUntil DateTime?
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([state, nextAttemptAt])
  @@map("mail_outbox")
  @@schema("ops")
}

model Workspace {
  id String @id @db.Uuid
  kind String
  name String
  personalOwnerId String? @unique
  personalOwner User? @relation("PersonalOwner", fields: [personalOwnerId], references: [id], onDelete: Restrict)
  createdBy String
  creator User @relation("WorkspaceCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  archivedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  members WorkspaceMember[]
  projects Project[]
  @@map("workspaces")
  @@schema("app")
}

model SchemaRevision {
  id Int @id
  revision String
  @@map("schema_revision")
  @@schema("ops")
}
model ServiceHeartbeat {
  service String @id
  revision String
  checkedAt DateTime @db.Timestamptz
  @@map("service_heartbeat")
  @@schema("ops")
}

model WorkspaceMember {
  workspaceId String @db.Uuid
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  role String
  active Boolean @default(true)
  createdAt DateTime @default(now())
  projectMemberships ProjectMember[]
  @@id([workspaceId, userId])
  @@map("workspace_members")
  @@schema("app")
}

model Project {
  id String @id @db.Uuid
  workspaceId String @db.Uuid
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  name String
  description String @default("")
  createdBy String
  creator User @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  archivedAt DateTime?
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  members ProjectMember[]
  invitations Invitation[]
  @@unique([workspaceId, id])
  @@map("projects")
  @@schema("app")
}

model ProjectMember {
  workspaceId String @db.Uuid
  projectId String @db.Uuid
  userId String
  project Project @relation(fields: [workspaceId, projectId], references: [workspaceId, id], onDelete: Restrict)
  workspaceMember WorkspaceMember @relation(fields: [workspaceId, userId], references: [workspaceId, userId], onDelete: Restrict)
  role String
  active Boolean @default(true)
  createdAt DateTime @default(now())
  @@id([workspaceId, projectId, userId])
  @@map("project_members")
  @@schema("app")
}

model Invitation {
  id String @id @db.Uuid
  workspaceId String @db.Uuid
  projectId String @db.Uuid
  project Project @relation(fields: [workspaceId, projectId], references: [workspaceId, id], onDelete: Restrict)
  email String
  role String
  tokenHash String @unique
  createdBy String
  creator User @relation("InvitationCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  originSessionId String
  expiresAt DateTime
  acceptedAt DateTime?
  acceptedBy String?
  acceptor User? @relation("InvitationAcceptor", fields: [acceptedBy], references: [id], onDelete: Restrict)
  revokedAt DateTime?
  createdAt DateTime @default(now())
  @@index([workspaceId, projectId, email])
  @@map("invitations")
  @@schema("app")
}

model AuditEvent {
  id String @id @db.Uuid
  workspaceId String @db.Uuid
  projectId String? @db.Uuid
  actorId String
  event String
  targetId String?
  createdAt DateTime @default(now())
  @@index([workspaceId, projectId, createdAt])
  @@map("audit_events")
  @@schema("app")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@map("sessions")
  @@schema("identity")
}

model Account {
  id                     String    @id
  accountId              String
  providerId             String
  userId                 String
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken            String?
  refreshToken           String?
  idToken                String?
  accessTokenExpiresAt   DateTime?
  refreshTokenExpiresAt  DateTime?
  scope                  String?
  password               String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  @@index([userId])
  @@unique([providerId, accountId])
  @@map("accounts")
  @@schema("identity")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@index([identifier])
  @@map("verifications")
  @@schema("identity")
}

model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt
  @@map("rate_limits")
  @@schema("identity")
}

model Artifact {
  id String @id @db.Uuid
  workspaceId String @db.Uuid
  projectId String @db.Uuid
  kind String
  createdAt DateTime @default(now())
  @@unique([workspaceId, projectId, id])
  @@map("artifacts")
  @@schema("app")
}
model Source {
  id String @id @db.Uuid
  workspaceId String @db.Uuid
  projectId String @db.Uuid
  title String
  authors String[]
  year Int?
  venue String @default("")
  doi String?
  url String?
  abstract String @default("")
  provenance Json
  tags String[]
  searchText String @default("")
  createdBy String
  archivedAt DateTime?
  revision Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([workspaceId, projectId, id])
  @@unique([workspaceId, projectId, doi])
  @@unique([workspaceId, projectId, url])
  @@map("sources")
  @@schema("app")
}
model SourceVersion {
  id String @id @db.Uuid
  workspaceId String @db.Uuid
  projectId String @db.Uuid
  sourceId String @db.Uuid
  ordinal Int
  fileId String? @unique @db.Uuid
  metadata Json
  extractionStatus String @default("metadata_only")
  pageCount Int?
  textCharacters Int?
  extractedAt DateTime?
  indexRevision String?
  createdAt DateTime @default(now())
  @@unique([workspaceId, projectId, id])
  @@unique([workspaceId, projectId, sourceId, id])
  @@unique([sourceId, ordinal])
  @@map("source_versions")
  @@schema("app")
}
model FileObject {
  id String @id @db.Uuid
  workspaceId String @db.Uuid
  projectId String @db.Uuid
  filename String
  sha256 String
  bytes Int
  createdBy String
  createdAt DateTime @default(now())
  @@unique([workspaceId, projectId, id])
  @@map("file_objects")
  @@schema("app")
}
model UploadIntent {
  id String @id @db.Uuid
  workspaceId String @db.Uuid
  projectId String @db.Uuid
  sourceId String @db.Uuid
  fileId String @db.Uuid
  versionId String? @db.Uuid
  createdBy String
  expectedBytes Int
  state String @default("uploading")
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("upload_intents")
  @@schema("app")
}
model Annotation {
  id String @id @db.Uuid
  workspaceId String @db.Uuid
  projectId String @db.Uuid
  sourceId String @db.Uuid
  versionId String @db.Uuid
  authorId String
  kind String
  page Int
  quote String @default("")
  body String @default("")
  rects Json
  color String @default("yellow")
  revision Int @default(1)
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([workspaceId, projectId, id])
  @@map("annotations")
  @@schema("app")
}
model Collection {
  id String @id @db.Uuid
  workspaceId String @db.Uuid
  projectId String @db.Uuid
  name String
  normalizedName String
  createdAt DateTime @default(now())
  @@unique([workspaceId, projectId, id])
  @@unique([projectId, normalizedName])
  @@map("collections")
  @@schema("app")
}
model SourceCollection {
  workspaceId String @db.Uuid
  projectId String @db.Uuid
  sourceId String @db.Uuid
  collectionId String @db.Uuid
  @@id([sourceId, collectionId])
  @@map("source_collections")
  @@schema("app")
}
model ReadingState {
  workspaceId String @db.Uuid
  projectId String @db.Uuid
  sourceId String @db.Uuid
  userId String
  versionId String? @db.Uuid
  status String @default("unread")
  page Int @default(1)
  zoom Float @default(1)
  position Float @default(0)
  updatedAt DateTime @updatedAt
  @@id([sourceId, userId])
  @@map("reading_states")
  @@schema("app")
}
model ReadingPosition {
  workspaceId String @db.Uuid
  projectId String @db.Uuid
  sourceId String @db.Uuid
  versionId String @db.Uuid
  userId String
  page Int @default(1)
  zoom Float @default(1)
  zoomMode String @default("manual")
  position Float @default(0)
  updatedAt DateTime @updatedAt
  @@id([versionId, userId])
  @@map("reading_positions")
  @@schema("app")
}
model FileJob {
  id String @id @db.Uuid
  workspaceId String @db.Uuid
  projectId String @db.Uuid
  versionId String @db.Uuid
  actorId String
  sessionId String
  state String @default("pending")
  attempts Int @default(0)
  error String?
  nextAttemptAt DateTime @default(now())
  leaseUntil DateTime?
  createdAt DateTime @default(now())
  @@index([state, nextAttemptAt])
  @@map("file_jobs")
  @@schema("ops")
}

model Document {
 id String @id @db.Uuid
 workspaceId String @db.Uuid
 projectId String @db.Uuid
 title String
 body Json
 revision Int @default(1)
 createdBy String
 archivedAt DateTime?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@unique([workspaceId,projectId,id])
 @@map("documents")
 @@schema("app")
}
model DocumentVersion {
 id String @id @db.Uuid
 workspaceId String @db.Uuid
 projectId String @db.Uuid
 documentId String @db.Uuid
 revision Int
 title String
 body Json
 createdBy String
 createdAt DateTime @default(now())
 @@unique([documentId,revision])
 @@map("document_versions")
 @@schema("app")
}
model DocumentWrite {
 id String @id @db.Uuid
 workspaceId String @db.Uuid
 projectId String @db.Uuid
 documentId String @db.Uuid
 requestId String @db.Uuid
 actorId String
 hash String
 revision Int
 createdAt DateTime @default(now())
 @@unique([documentId,requestId])
 @@map("document_writes")
 @@schema("app")
}
model Citation {
 id String @id @db.Uuid
 workspaceId String @db.Uuid
 projectId String @db.Uuid
 documentId String @db.Uuid
 sourceId String @db.Uuid
 versionId String @db.Uuid
 annotationId String? @db.Uuid
 pageId String? @db.Uuid
 start Int?
 end Int?
 page Int?
 quote String
 createdAt DateTime @default(now())
 @@unique([workspaceId,projectId,id])
 @@map("citations")
 @@schema("app")
}
model ArtifactLink {
 workspaceId String @db.Uuid
 projectId String @db.Uuid
 fromId String @db.Uuid
 toId String @db.Uuid
 @@id([fromId,toId])
 @@map("artifact_links")
 @@schema("app")
}
model Task {
 id String @id @db.Uuid
 workspaceId String @db.Uuid
 projectId String @db.Uuid
 title String
 description String @default("")
 status String @default("backlog")
 priority String @default("medium")
 assigneeId String?
 dueDate String?
 revision Int @default(1)
 archivedAt DateTime?
 createdBy String
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@unique([workspaceId,projectId,id])
 @@map("tasks")
 @@schema("app")
}
model Discussion {
 id String @id @db.Uuid
 workspaceId String @db.Uuid
 projectId String @db.Uuid
 title String
 createdBy String
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@unique([workspaceId,projectId,id])
 @@map("discussions")
 @@schema("app")
}
model Message {
 id String @id @db.Uuid
 workspaceId String @db.Uuid
 projectId String @db.Uuid
 discussionId String @db.Uuid
 authorId String
 clientId String @db.Uuid
 artifactIds String[] @db.Uuid
 body String
 revision Int @default(1)
 editedAt DateTime?
 createdAt DateTime @default(now())
 @@unique([discussionId,authorId,clientId])
 @@map("messages")
 @@schema("app")
}
model Notification {
 id String @id @db.Uuid
 workspaceId String @db.Uuid
 projectId String @db.Uuid
 recipientId String
 targetId String @db.Uuid
 event String
 eventId String
 readAt DateTime?
 createdAt DateTime @default(now())
 @@unique([recipientId,eventId])
 @@map("notifications")
 @@schema("app")
}

model SourcePage {
 id String @id @db.Uuid
 workspaceId String @db.Uuid
 projectId String @db.Uuid
 sourceId String @db.Uuid
 versionId String @db.Uuid
 page Int
 text String
 sha256 String
 fileSha256 String
 extractor String
 createdAt DateTime @default(now())
 @@unique([workspaceId,projectId,id])
 @@unique([versionId,page,extractor])
 @@map("source_pages")
 @@schema("app")
}
model SourceChunk {
 id String @id @db.Uuid
 workspaceId String @db.Uuid
 projectId String @db.Uuid
 pageId String @db.Uuid
 start Int
 end Int
 text String
 @@unique([pageId,start])
 @@map("source_chunks")
 @@schema("app")
}
model AiPolicy {
 workspaceId String @id @db.Uuid
 enabled Boolean @default(false)
 dailyBudgetMicros Int @default(0)
 revision Int @default(1)
 termsVersion String @default("")
 updatedAt DateTime @updatedAt
 @@map("ai_policies")
 @@schema("app")
}
model AiConversation {
 id String @id @db.Uuid
 workspaceId String @db.Uuid
 projectId String @db.Uuid
 userId String
 title String
 versionIds String[] @db.Uuid
 createdAt DateTime @default(now())
 @@unique([workspaceId,projectId,id])
 @@map("ai_conversations")
 @@schema("app")
}
model AiContext {
 id String @id @db.Uuid
 workspaceId String @db.Uuid
 projectId String @db.Uuid
 userId String
 conversationId String @db.Uuid
 question String
 expiresAt DateTime
 createdAt DateTime @default(now())
 @@unique([workspaceId,projectId,id])
 @@map("ai_contexts")
 @@schema("app")
}
model AiEvidence {
 id String @id @db.Uuid
 workspaceId String @db.Uuid
 projectId String @db.Uuid
 userId String
 contextId String @db.Uuid
 pageId String @db.Uuid
 sourceId String @db.Uuid
 versionId String @db.Uuid
 page Int
 start Int
 end Int
 quote String
 quoteHash String
 fileSha256 String
 extractor String
 createdAt DateTime @default(now())
 @@unique([workspaceId,projectId,id])
 @@map("ai_evidence")
 @@schema("app")
}
model AiRun {
 id String @id @db.Uuid
 workspaceId String @db.Uuid
 projectId String @db.Uuid
 userId String
 sessionId String
 conversationId String @db.Uuid
 contextId String @unique @db.Uuid
 requestId String @db.Uuid
 policyRevision Int
 state String @default("queued")
 error String?
 model String
 reservedMicros Int
 chargedMicros Int @default(0)
 inputTokens Int?
 outputTokens Int?
 result Json?
 dispatchedAt DateTime?
 expiresAt DateTime
 completedAt DateTime?
 createdAt DateTime @default(now())
 @@unique([conversationId,requestId])
 @@unique([workspaceId,projectId,id])
 @@map("ai_runs")
 @@schema("app")
}
model AiProposal {
 id String @id @db.Uuid
 workspaceId String @db.Uuid
 projectId String @db.Uuid
 userId String
 runId String @db.Uuid
 documentId String @db.Uuid
 revision Int
 before Json
 after Json
 citationPlan Json
 appliedRevision Int?
 previousVersionId String? @db.Uuid
 undoRevision Int?
 createdAt DateTime @default(now())
 @@map("ai_proposals")
 @@schema("app")
}

model AiReview {
 id String @id @db.Uuid
 workspaceId String @db.Uuid
 projectId String @db.Uuid
 userId String
 runId String @db.Uuid
 segment Int
 verdict String
 updatedAt DateTime @updatedAt
 @@unique([runId,segment])
 @@map("ai_reviews")
 @@schema("app")
}
