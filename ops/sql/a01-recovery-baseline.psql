-- G2 DATA-DERIVED EXPORT. DO NOT RUN against hosted data before G2 approval.
-- Pipe stdout directly to approved authenticated encryption; no public logs.
-- Source: supply -v atlas_snapshot=... from the held exported snapshot.
-- Destination: omit that variable. Use psql -X -q -A -t -v ON_ERROR_STOP=1.
BEGIN ISOLATION LEVEL REPEATABLE READ READ ONLY;
\if :{?atlas_snapshot}
SET TRANSACTION SNAPSHOT :'atlas_snapshot';
\endif
SET LOCAL TIME ZONE 'UTC';

SELECT jsonb_build_object('kind','relations','items',jsonb_agg(
 jsonb_build_object('schema',n.nspname,'table',c.relname,'owner',pg_get_userbyid(c.relowner),
 'rls',c.relrowsecurity,'force_rls',c.relforcerowsecurity) ORDER BY n.nspname,c.relname))
 FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace
 WHERE n.nspname IN ('public','atlas_private','auth','storage') AND c.relkind IN ('r','p');

SELECT format('SELECT jsonb_build_object(''kind'',''table'',''schema'',%L,''table'',%L,''rows'',count(*),''sha256'',encode(sha256(convert_to(coalesce(string_agg(to_jsonb(t)::text,chr(10) ORDER BY to_jsonb(t)::text COLLATE "C"),''''),''UTF8'')),''hex'')) FROM %I.%I t',
 schemaname,tablename,schemaname,tablename)
 FROM pg_tables WHERE schemaname IN ('public','atlas_private','auth','storage')
 ORDER BY schemaname,tablename
\gexec

SELECT jsonb_build_object('kind','prisma_history','items',jsonb_agg(
 jsonb_build_object('name',migration_name,'checksum',checksum,
 'finished',finished_at IS NOT NULL,'rolled_back',rolled_back_at IS NOT NULL) ORDER BY migration_name))
 FROM public._prisma_migrations;

SELECT jsonb_build_object('kind','constraints','items',jsonb_agg(
 jsonb_build_object('schema',n.nspname,'table',c.relname,'name',k.conname,
 'type',k.contype,'validated',k.convalidated,'definition',pg_get_constraintdef(k.oid))
 ORDER BY n.nspname,c.relname,k.conname))
 FROM pg_constraint k JOIN pg_class c ON c.oid=k.conrelid JOIN pg_namespace n ON n.oid=c.relnamespace
 WHERE n.nspname IN ('public','atlas_private','auth','storage');

SELECT jsonb_build_object('kind','policies','items',jsonb_agg(to_jsonb(p) ORDER BY schemaname,tablename,policyname))
 FROM pg_policies p WHERE schemaname IN ('public','atlas_private','auth','storage');

SELECT jsonb_build_object('kind','relation_acl','items',jsonb_agg(
 jsonb_build_object('schema',n.nspname,'object',c.relname,'object_kind',c.relkind,
 'grantee',CASE WHEN a.grantee=0 THEN 'PUBLIC' ELSE pg_get_userbyid(a.grantee) END,
 'grantor',pg_get_userbyid(a.grantor),'privilege',a.privilege_type,'grantable',a.is_grantable)
 ORDER BY n.nspname,c.relname,a.privilege_type,a.grantee))
 FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace
 CROSS JOIN LATERAL aclexplode(coalesce(c.relacl,acldefault(CASE WHEN c.relkind='S' THEN 'S'::"char" ELSE 'r'::"char" END,c.relowner))) a
 WHERE n.nspname IN ('public','atlas_private','auth','storage') AND c.relkind IN ('r','p','S');

SELECT jsonb_build_object('kind','column_acl','items',jsonb_agg(
 jsonb_build_object('schema',n.nspname,'table',c.relname,'column',at.attname,
 'grantee',CASE WHEN a.grantee=0 THEN 'PUBLIC' ELSE pg_get_userbyid(a.grantee) END,
 'grantor',pg_get_userbyid(a.grantor),'privilege',a.privilege_type,'grantable',a.is_grantable)
 ORDER BY n.nspname,c.relname,at.attname,a.privilege_type,a.grantee))
 FROM pg_attribute at JOIN pg_class c ON c.oid=at.attrelid JOIN pg_namespace n ON n.oid=c.relnamespace
 CROSS JOIN LATERAL aclexplode(at.attacl) a
 WHERE n.nspname IN ('public','atlas_private','auth','storage') AND at.attnum>0 AND NOT at.attisdropped;

SELECT jsonb_build_object('kind','functions','items',jsonb_agg(jsonb_build_object(
 'schema',n.nspname,'name',p.proname,'arguments',pg_get_function_identity_arguments(p.oid),
 'owner',pg_get_userbyid(p.proowner),'security_definer',p.prosecdef,'configuration',p.proconfig,
 'definition_hash',encode(sha256(convert_to(pg_get_functiondef(p.oid),'UTF8')),'hex'),
 'acl',(SELECT jsonb_agg(jsonb_build_object('grantee',CASE WHEN a.grantee=0 THEN 'PUBLIC' ELSE pg_get_userbyid(a.grantee) END,
 'privilege',a.privilege_type,'grantable',a.is_grantable)) FROM aclexplode(coalesce(p.proacl,acldefault('f',p.proowner))) a))
 ORDER BY n.nspname,p.proname,pg_get_function_identity_arguments(p.oid)))
 FROM pg_proc p JOIN pg_namespace n ON n.oid=p.pronamespace
 WHERE n.nspname IN ('public','atlas_private','auth','storage') AND p.prokind IN ('f','p');

SELECT jsonb_build_object('kind','extensions','items',jsonb_agg(
 jsonb_build_object('name',e.extname,'version',e.extversion,'schema',n.nspname) ORDER BY e.extname))
 FROM pg_extension e JOIN pg_namespace n ON n.oid=e.extnamespace;

SELECT jsonb_build_object('kind','role_attributes','items',jsonb_agg(
 jsonb_build_object('name',rolname,'login',rolcanlogin,'inherit',rolinherit,
 'superuser',rolsuper,'bypassrls',rolbypassrls,'createdb',rolcreatedb,
 'createrole',rolcreaterole,'replication',rolreplication) ORDER BY rolname))
 FROM pg_roles WHERE rolname LIKE 'atlas_%' OR rolname IN ('anon','authenticated','postgres');

SELECT jsonb_build_object('kind','role_memberships','items',jsonb_agg(
 jsonb_build_object('member',pg_get_userbyid(member),'role',pg_get_userbyid(roleid),
 'inherit',inherit_option,'set',set_option,'admin',admin_option)
 ORDER BY pg_get_userbyid(member),pg_get_userbyid(roleid))) FROM pg_auth_members;

SELECT jsonb_build_object('kind','default_acl','items',jsonb_agg(
 jsonb_build_object('creator',pg_get_userbyid(d.defaclrole),'schema',coalesce(n.nspname,'GLOBAL'),
 'object_kind',d.defaclobjtype,'grantee',CASE WHEN a.grantee=0 THEN 'PUBLIC' ELSE pg_get_userbyid(a.grantee) END,
 'grantor',pg_get_userbyid(a.grantor),'privilege',a.privilege_type,'grantable',a.is_grantable)
 ORDER BY pg_get_userbyid(d.defaclrole),n.nspname,d.defaclobjtype,a.privilege_type,a.grantee))
 FROM pg_default_acl d LEFT JOIN pg_namespace n ON n.oid=d.defaclnamespace
 CROSS JOIN LATERAL aclexplode(d.defaclacl) a
 WHERE d.defaclnamespace=0 OR n.nspname IN ('public','atlas_private','auth','storage');
COMMIT;
