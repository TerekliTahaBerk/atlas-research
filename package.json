{
  "name": "atlas-research",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.21.0",
    "npm": "11.19.0"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "prisma generate && node ops/copy-pdf-worker.mjs && tsc -p tsconfig.worker.json && next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "prisma generate && next typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "node --import tsx --test tests/unit/*.test.ts",
    "test:integration": "node --import tsx scripts/test-integration.ts",
    "test:library": "node --import tsx scripts/test-integration.ts --library",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "verify": "npm run typecheck && npm run lint && npm test && npm run test:integration && npm run build && npm run test:browser",
    "test:browser": "node --import tsx scripts/test-integration.ts --browser",
    "test:operations": "node --import tsx scripts/test-operations.ts",
    "verify:release": "node ops/verify-release.mjs",
    "verify:compose": "node ops/validate-compose.mjs",
    "format:check": "prettier --check src/components src/lib scripts/browser-qa.ts",
    "postinstall": "prisma generate",
    "mail:worker": "node dist/worker/mail/run.js"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "better-auth": "1.7.18",
    "next": "16.4.5",
    "nodemailer": "10.4.0",
    "pdfjs-dist": "6.5.438",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/cli": "0.1.23",
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/smtp-server": "3.5.13",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.5",
    "playwright": "1.65.0",
    "prettier": "3.9.10",
    "prisma": "7.10.1",
    "smtp-server": "3.21.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "11.0.1"
  }
}
