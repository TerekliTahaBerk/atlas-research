# Default public design demo; never host private research in this mode.
ATLAS_MODE=preview
# For the real platform use ATLAS_MODE=live at BOTH build and runtime.
# Put web configuration in apps/web/.env.local. Root .env is Prisma CLI only.
# ATLAS_ORIGIN=http://127.0.0.1:3000
# NEXT_PUBLIC_SUPABASE_URL=https://your-isolated-atlas-project.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-public-publishable-key
# DATABASE_URL=postgresql://RUNTIME_USER:RUNTIME_PASSWORD@HOST:PORT/ATLAS_DATABASE
# DIRECT_URL=postgresql://MIGRATION_USER:MIGRATION_PASSWORD@HOST:PORT/ATLAS_DATABASE
# Hosted TLS: append ?sslmode=verify-full&sslrootcert=/absolute/mounted/public-ca.crt
# Download the public CA from the verified Atlas project; never disable verification.
# Runtime: non-owner, NOSUPERUSER, NOBYPASSRLS, member of atlas_runtime.
# Migration credentials belong only to migration jobs, not the web deployment.
# ATLAS_RATE_SECRET=generate-a-unique-random-value-of-at-least-32-characters
# ATLAS_CURSOR_SECRET=generate-a-different-random-value-of-at-least-32-characters
# ATLAS_GOOGLE_OAUTH=false
# Enable only after configuring the Google provider in the isolated Atlas project.
# ATLAS_DEV_INVITATION_LINKS=false
# true only on loopback next dev; always blocked in production.
# No invitation email provider is installed. Production creation fails closed.
# Phase 02 research library (all server-only; never prefix with NEXT_PUBLIC_):
# ATLAS_OPENALEX_API_KEY=optional-openalex-key-raises-the-atlas-hourly-budget
# ATLAS_OPENALEX_MAILTO=research-ops@example.org
# ATLAS_SEMANTIC_SCHOLAR_API_KEY=optional-semantic-scholar-key
# Base URLs default to the official HTTPS APIs; only HTTPS or loopback test
# fixtures are accepted.
# ATLAS_OPENALEX_BASE_URL=https://api.openalex.org
# ATLAS_SEMANTIC_SCHOLAR_BASE_URL=https://api.semanticscholar.org
# Private PDF storage: the Storage secret/service key of the SAME isolated
# Atlas project. Server-only; it signs single-object grants after Atlas
# authorization. Without it, uploads and PDF access are reported unavailable.
# ATLAS_STORAGE_SERVICE_KEY=
# Isolated scanner HMAC secret (>= 32 chars). Without an approved scanner,
# uploads stay quarantined and unreadable by design.
# ATLAS_SCANNER_SECRET=generate-a-unique-random-value-of-at-least-32-characters
# Phase 01 needs no service-role key; never expose server credentials via NEXT_PUBLIC_.
# Tests: explicit disposable local PostgreSQL, never staging/production.
# ATLAS_TEST_ADMIN_URL=postgresql://TEST_MIGRATOR:TEST_PASSWORD@127.0.0.1:PORT/atlas_p01_test
# ATLAS_TEST_DATABASE_URL=postgresql://TEST_RUNTIME:TEST_PASSWORD@127.0.0.1:PORT/atlas_p01_test
# Auth email/redirect setup, local harness and activation gates:
# docs/identity/ENVIRONMENTS.md, docs/identity/AUTHENTICATION.md
# Phase 03: server-only, disabled until security/recovery and provider review.
# ATLAS_AI_ACTIVATION=reviewed-hosted
# For isolated loopback tests only: isolated-local + atlas_p01_test*/atlas_auth_test DB.
# ATLAS_AI_PAID_REQUESTS=approved
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# Model IDs and integer micro-USD tariffs must be approved; no production default.
# ATLAS_AI_MODEL_POLICY={"provider":"openai","model":"APPROVED_MODEL_ID","contextTokens":64000,"maxOutputTokens":1000,"inputMicrosPerMillion":100000,"outputMicrosPerMillion":200000}
# Above tariff values illustrate configuration units, not current provider pricing.
# ATLAS_AI_MONTHLY_LIMIT_MICROS=1000000
# ATLAS_AI_EMBEDDING_PROVIDER=openai
# ATLAS_AI_EMBEDDING_MODEL=APPROVED_EMBEDDING_MODEL_ID
# ATLAS_AI_EMBEDDING_REVISION=approved-v1
# ATLAS_AI_EMBEDDING_MICROS_PER_MILLION=APPROVED_INTEGER_TARIFF
# ATLAS_AI_RETENTION_DAYS=30
# Separate non-owner worker login: member only of atlas_ai_worker, NOT atlas_runtime.
# ATLAS_AI_WORKER_DATABASE_URL=postgresql://WORKER:WORKER_PASSWORD@HOST:PORT/ATLAS_DATABASE
# ATLAS_EXTRACTION_SECRET=unique-dedicated-HMAC-secret-at-least-32-characters
# Broker deployment inputs (not a deployment approval):
# ATLAS_EXTRACTION_ORIGIN=https://approved-atlas-live-origin.example
# ATLAS_EXTRACTION_SECRET_FILE=/approved/mounted/secret-file
# Test-only loopback wire fixture, never accepted with a hosted database/origin:
# ATLAS_AI_FIXTURE_ORIGIN=http://127.0.0.1:3198
# ATLAS_TEST_AI_WORKER_URL=postgresql://TEST_WORKER:TEST_PASSWORD@127.0.0.1:PORT/atlas_p01_test

# Phase 04 documents/tasks/search need no new settings; they reuse DATABASE_URL,
# ATLAS_RATE_SECRET and ATLAS_CURSOR_SECRET. AI proposals reuse the gated Phase 03 settings.
