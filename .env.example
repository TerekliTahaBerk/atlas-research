# Phase 00 needs no credentials. Copy to .env for database CLI only.
# Next.js reads apps/web/.env.local; do not duplicate secrets into NEXT_PUBLIC_*.
ATLAS_MODE=preview
# Optional FUTURE integrations; leave unset for Phase 00.
# NEXT_PUBLIC_SUPABASE_URL=https://your-isolated-atlas-project.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# DATABASE_URL=postgresql://atlas:password@127.0.0.1:5432/atlas_dev
# DIRECT_URL=postgresql://atlas:password@127.0.0.1:5432/atlas_dev
# SUPABASE_SECRET_KEY=        # server only, Phase 01
# INNGEST_EVENT_KEY=          # server only, future background jobs
# INNGEST_SIGNING_KEY=        # server only, future background jobs
# AI credentials will be provisioned through the selected provider in Phase 03.
