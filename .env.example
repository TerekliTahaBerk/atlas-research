# Runtime values only. Generate independent secrets; never copy production data locally.
APP_ORIGIN=http://127.0.0.1:3000
BETTER_AUTH_SECRET=
AUTH_DATABASE_URL=
DATABASE_URL=
QUEUE_DATABASE_URL=
# Private volume shared only by Atlas web/files worker. Empty disables uploads.
FILE_STORAGE_PATH=
ATLAS_RELEASE=local
# smtp for full local flows; disabled suppresses enqueue/dispatch and mail-only UI.
MAIL_DELIVERY=smtp
# Available only to the separate migration process, never the web container.
MIGRATION_DATABASE_URL=
# Optional owner-authorized first identity, migration process only; clear after setup.
ATLAS_INITIAL_USER_ACK=
ATLAS_INITIAL_EMAIL=
ATLAS_INITIAL_PASSWORD=
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=atlas@example.invalid
