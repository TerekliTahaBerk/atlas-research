# Runtime values only. Generate independent secrets; never copy production data locally.
APP_ORIGIN=http://127.0.0.1:3000
BETTER_AUTH_SECRET=
AUTH_DATABASE_URL=
DATABASE_URL=
QUEUE_DATABASE_URL=
# Private volume shared only by Atlas web/files worker. Empty disables uploads.
FILE_STORAGE_PATH=
ATLAS_RELEASE=local
# smtp for full local flows; disabled suppresses enqueue/dispatch and mail-only UI.
MAIL_DELIVERY=smtp
# Available only to the separate migration process, never the web container.
MIGRATION_DATABASE_URL=
# Optional owner-authorized first identity, migration process only; clear after setup.
ATLAS_INITIAL_USER_ACK=
ATLAS_INITIAL_EMAIL=
ATLAS_INITIAL_PASSWORD=
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=atlas@example.invalid

# Atlas AI: existing key, web only. Calls stay OFF until explicit owner approval and budget.
OPENAI_API_KEY=
ATLAS_AI_CALLS_ENABLED=false
# Optional. Only models present in the versioned provider pricing registry can dispatch.
ATLAS_AI_MODEL=


# Commercial rollout gates. Keep off until metering and retention are verified.
ATLAS_RESOURCE_LIMITS_ENABLED=0
ATLAS_FOUNDING_INTAKE_ENABLED=0
ATLAS_FOUNDING_MAIL_ENABLED=0
# Test-only signed provider simulation. The production route always rejects it.
ATLAS_BILLING_SANDBOX_ENABLED=0
ATLAS_BILLING_SANDBOX_SECRET=
