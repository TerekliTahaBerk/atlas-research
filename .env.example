# Default public design demo; never host private research in this mode.
ATLAS_MODE=preview
# For the real platform use ATLAS_MODE=live at BOTH build and runtime.
# Put web configuration in apps/web/.env.local. Root .env is Prisma CLI only.
# ATLAS_ORIGIN=http://127.0.0.1:3000
# NEXT_PUBLIC_SUPABASE_URL=https://your-isolated-atlas-project.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-public-publishable-key
# DATABASE_URL=postgresql://RUNTIME_USER:RUNTIME_PASSWORD@HOST:PORT/ATLAS_DATABASE
# DIRECT_URL=postgresql://MIGRATION_USER:MIGRATION_PASSWORD@HOST:PORT/ATLAS_DATABASE
# Runtime: non-owner, NOSUPERUSER, NOBYPASSRLS, member of atlas_runtime.
# Migration credentials belong only to migration jobs, not the web deployment.
# ATLAS_RATE_SECRET=generate-a-unique-random-value-of-at-least-32-characters
# ATLAS_CURSOR_SECRET=generate-a-different-random-value-of-at-least-32-characters
# ATLAS_GOOGLE_OAUTH=false
# Enable only after configuring the Google provider in the isolated Atlas project.
# ATLAS_DEV_INVITATION_LINKS=false
# true only on loopback next dev; always blocked in production.
# No invitation email provider is installed. Production creation fails closed.
# No service-role key is required; never expose server credentials via NEXT_PUBLIC_.
# Tests: explicit disposable local PostgreSQL, never staging/production.
# ATLAS_TEST_ADMIN_URL=postgresql://TEST_MIGRATOR:TEST_PASSWORD@127.0.0.1:PORT/atlas_p01_test
# ATLAS_TEST_DATABASE_URL=postgresql://TEST_RUNTIME:TEST_PASSWORD@127.0.0.1:PORT/atlas_p01_test
# Auth email/redirect setup, local harness and activation gates:
# docs/identity/ENVIRONMENTS.md, docs/identity/AUTHENTICATION.md
